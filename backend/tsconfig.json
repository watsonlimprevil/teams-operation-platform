{
  "compilerOptions": {
    // Core module + target settings for Node + Express
    "target": "ES2020",
    "module": "commonjs",

    // Folder structure
    "rootDir": "./src",
    "outDir": "./dist",

    // Allow default imports like: import express from "express"
    "esModuleInterop": true,

    // Strict type checking (recommended)
    "strict": true,

    // Avoid noise from type definitions
    "skipLibCheck": true,

    "strictNullChecks": false,

    // Allow TS to compile isolated files (good for Node)
    "isolatedModules": false,

    // Generate source maps for debugging
    "sourceMap": true
  },

  // Include your source folder
  "include": ["src"]
}
